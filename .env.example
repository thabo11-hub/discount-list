# Copy to .env.local for local work. Real values live ONLY in Vercel project settings
# (Environment Variables, type "Sensitive"). Never commit a real value.

# Supabase project URL and its publishable (anon) key. The key only works together with
# SERVER_KEY, because every database function checks the server key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Random secrets: generate each with `node scripts/gen-secret.mjs`
SERVER_KEY=generate-me
IP_HASH_SALT=generate-me
CRON_SECRET=generate-me

# The site's own address, used in password reset links
APP_ORIGIN=https://your-app.vercel.app

# Optional: password reset emails through Resend (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=TrolleyScout <no-reply@your-domain.co.za>
